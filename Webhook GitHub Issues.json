        "jsonBody": "={\n  \"model\": \"claude-haiku-4-5-20251001\",\n  \"max_tokens\": 300,\n  \"messages\": [\n    {\n      \"role\": \"user\",\n      \"content\": \"Alguien abrió este issue en GitHub: '{{ $json.body.issue.title }}'. Escribe un comentario útil y amigable en español sugiriendo cómo abordarlo. Máximo 3 oraciones.\"\n    }\n  ]\n}",
