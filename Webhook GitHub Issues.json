    {
      "parameters": {
        "jsCode": "const text = $input.first().json.content[0].text.replace(/\\n/g, ' ');\nconst issueNumber = $('Webhook').first().json.body.issue.number;\n\nreturn [{\n  json: {\n    comment: text,\n    issueNumber: issueNumber\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
